#!/usr/bin/env bash
# pr2 — step-by-step prediction pipeline (uses pipeline.py instead of analyze_from_data)
# Original pr still works unchanged.
set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    TARGET="$(readlink "$SOURCE")"
    case "$TARGET" in
        /*) SOURCE="$TARGET" ;;
        *) SOURCE="$(dirname "$SOURCE")/$TARGET" ;;
    esac
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

if [ -x "$DIR/.venv/bin/python" ]; then
    PYTHON="$DIR/.venv/bin/python"
else
    echo "No .venv found. Run scripts/install.sh first." >&2
    exit 1
fi

exec "$PYTHON" "$DIR/predict2.py" "$@"
