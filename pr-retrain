#!/usr/bin/env bash
# Retrain ML model + calibrate from played results
set -e
cd /home/stdk/predictor
PYTHON=.venv/bin/python3

echo "[1/3] Retraining ML model..."
$PYTHON ml_model.py --train

echo "[2/3] Running calibration analysis..."
$PYTHON calibration_learner.py --analyze

echo "[3/3] Isotonic regression retrain..."
$PYTHON -c "from calibration_learner import retrain_from_results; retrain_from_results(force=True)"

echo "Done. Model learned from all results."
